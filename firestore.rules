rules_version = '2';

// Security rules for the Travel Songkhla leaderboard.
// Paste these into: Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard: anyone may read the rankings; a signed-in user may write
    // ONLY their own row (doc id must equal their auth uid). Everything else
    // is denied by default.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }
  }
}
